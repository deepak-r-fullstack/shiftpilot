{
  "name": "shiftpilot-server",
  "version": "1.0.0",
  "private": true,
  "description": "ShiftPilot API: scheduling rules, the scheduling agent, proposals and apply through AgentGuard",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "evals": "tsx evals/run.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.142",
    "@ai-sdk/openai": "^3.0.143",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sritarak/agentreplay": "^0.2.0",
    "ai": "^6.0.332",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
