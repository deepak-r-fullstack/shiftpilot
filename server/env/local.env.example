# Copy to local.env. Real values never go in git.
PORT=5060
MONGO_URI=mongodb://127.0.0.1:27017/shiftpilot
CLIENT_ORIGIN=http://localhost:5174
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true
SEED_ON_START=true

# AI that plans schedule changes: anthropic | openai | none
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
AI_DAILY_USD_CAP=1

# Optional: apply approved plans through AgentGuard
AGENTGUARD_URL=http://localhost:5050
AGENTGUARD_PUBLIC_URL=http://localhost:5173
SHIFTPILOT_AGENT_KEY=
SHIFTPILOT_INTERNAL_SECRET=

# Optional: record agent runs in AgentReplay
AGENTREPLAY_API_KEY=
AGENTREPLAY_URL=
